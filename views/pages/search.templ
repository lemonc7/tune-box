package pages

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"github.com/lemonc7/tune-go/internal/model"
	"github.com/lemonc7/tune-go/views/components"
	"github.com/lemonc7/tune-go/views/layout"
)

// 抽取公共 Tailwind 类名，保持 HTML 干净整洁
const (
	clsInput      = "w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm transition-colors focus:border-indigo-500 focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-indigo-500/20"
	clsBtnPrimary = "inline-flex cursor-pointer items-center justify-center rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-indigo-700 hover:shadow focus:outline-hidden focus:ring-2 focus:ring-indigo-500/50"
	clsCard       = "group mt-3 flex flex-col gap-3 rounded-xl border border-slate-100 bg-white p-4 transition-all hover:border-indigo-100 hover:shadow-md sm:flex-row sm:items-center"
)

templ SearchPage(
	providers []string,
	request model.SearchRequest,
	result *model.SearchResult,
	message string,
) {
	@layout.Layout("TuneGo", SearchContent(providers, request, result, message))
}

templ SearchContent(
	providers []string,
	request model.SearchRequest,
	result *model.SearchResult,
	message string,
) {
	<section class="mb-6 overflow-hidden rounded-2xl border border-indigo-100 bg-gradient-to-br from-indigo-50/90 via-white to-white p-6 shadow-sm">
		<header class="mb-5">
			<p class="mb-1 text-[0.65rem] font-extrabold uppercase tracking-[0.15em] text-indigo-600">TuneGo Search</p>
			<h1 class="mb-1 text-2xl font-bold">找到想听的音乐</h1>
			<p class="text-sm text-slate-500">选择音乐源，按歌曲、歌手或专辑搜索。</p>
		</header>
		<form
			class="space-y-4"
			action="/search"
			method="get"
			hx-get="/search"
			hx-target="#search-results"
			hx-swap="innerHTML"
			hx-indicator="#search-loading"
		>
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-[minmax(10rem,0.3fr)_minmax(16rem,1fr)]">
				<label class="grid gap-1.5 text-xs font-semibold text-slate-600">
					音乐源
					<select name="provider" required class={ clsInput }>
						for _, name := range providers {
							<option value={ name } selected?={ request.Provider == name }>
								{ name }
							</option>
						}
					</select>
				</label>
				<label class="grid gap-1.5 text-xs font-semibold text-slate-600">
					关键词
					<input name="q" type="search" placeholder="歌曲、歌手或专辑" value={ request.Query } required class={ clsInput }/>
				</label>
			</div>
			<div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
				<label class="inline-flex cursor-pointer items-center gap-3 rounded-xl border border-indigo-100 bg-white/80 px-3 py-2.5">
					<input name="lossless" type="checkbox" value="true" checked?={ request.Lossless } class="peer sr-only"/>
					<span class="relative h-5 w-9 shrink-0 rounded-full bg-slate-300 transition-colors peer-checked:bg-indigo-600 after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:after:translate-x-4"></span>
					<span class="grid gap-0.5">
						<strong class="text-sm text-slate-700">仅显示无损</strong>
						<small class="text-xs text-slate-400">FLAC / APE / Hi-Res</small>
					</span>
				</label>
				<div class="flex w-full items-center justify-end gap-3 sm:w-auto">
					<span id="search-loading" class="htmx-indicator inline-flex items-center gap-1.5 text-sm text-indigo-600">
						<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
						<span>搜索中...</span>
					</span>
					<button type="submit" class={ clsBtnPrimary }>
						搜索音乐
					</button>
				</div>
			</div>
			<input name="page" type="hidden" value="1"/>
			<input name="limit" type="hidden" value="20"/>
		</form>
	</section>
	<section
		id="search-results"
		aria-live="polite"
		class="rounded-2xl border border-slate-200 bg-white/95 p-6 shadow-sm"
	>
		if message != "" {
			@components.ErrorNotice(message)
		} else if result != nil {
			@SearchResults(*result, request.Lossless)
		} else {
			@components.Empty("请输入关键词开始搜索")
		}
	</section>
}

templ SearchResults(result model.SearchResult, lossless bool) {
	if len(result.Tracks) == 0 {
		@components.Empty("本页没有符合条件的歌曲")
	} else {
		<div class="mb-3 flex items-baseline justify-between gap-3 border-b border-slate-100 pb-2">
			<h2 class="text-lg font-bold text-slate-800">搜索结果</h2>
			<span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-600">
				{ fmt.Sprintf("共 %d 条结果", result.Total) }
			</span>
		</div>
		@TrackList(result, lossless)
	}
}

templ TrackList(result model.SearchResult, lossless bool) {
	for _, track := range result.Tracks {
		@TrackCard(track)
	}
	if result.Page*result.Limit < result.Total {
		@searchSentinel(result, lossless, result.Page+1)
	}
}

templ TrackCard(track model.Track) {
	<div class={ clsCard }>
		if track.CoverURL != "" {
			<img src={ track.CoverURL } alt={ track.Name } loading="lazy" class="h-16 w-16 shrink-0 rounded-lg bg-slate-100 object-cover shadow-xs"/>
		} else {
			<div class="h-16 w-16 shrink-0 rounded-lg bg-slate-100"></div>
		}
		<div class="min-w-0 flex-1">
			<h3 class="truncate text-base font-bold text-slate-800">
				{ track.Name }
			</h3>
			<div class="mt-1 flex items-center gap-2 text-xs text-slate-500">
				<span class="truncate font-medium text-slate-600">{ strings.Join(track.Artists, " / ") }</span>
				if track.Album != "" {
					<span>•</span>
					<span class="truncate">{ track.Album }</span>
				}
				if track.Date != "" {
					<span>•</span>
					<span class="truncate">{ track.Date }</span>
				}
			</div>
			<div class="mt-3 flex flex-wrap items-center gap-2">
				for _, quality := range track.Qualities {
					@components.ResolveButton(track, quality)
				}
			</div>
		</div>
		<div id={ fmt.Sprintf("notify-%s-%s", track.Provider, track.ID) } class="shrink-0"></div>
	</div>
}

templ searchSentinel(result model.SearchResult, lossless bool, page int) {
	<div
		id="search-more"
		hx-get={ searchPageURL(result, lossless, page) }
		hx-trigger="revealed once"
		hx-swap="outerHTML"
		class="mt-6 flex justify-center py-4"
	>
		<span class="htmx-indicator inline-flex items-center gap-2 text-sm font-medium text-indigo-500">
			<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
			<span>加载更多...</span>
		</span>
	</div>
}

func searchPageURL(result model.SearchResult, lossless bool, page int) string {
	values := url.Values{}
	values.Set("provider", result.Provider)
	values.Set("q", result.Query)
	values.Set("page", strconv.Itoa(page))
	values.Set("limit", strconv.Itoa(result.Limit))
	if lossless {
		values.Set("lossless", "true")
	}
	return "/search?" + values.Encode()
}
