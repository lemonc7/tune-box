package pages

import (
	"fmt"
	"github.com/lemonc7/tune-go/internal/model"
	"github.com/lemonc7/tune-go/internal/provider"
	"github.com/lemonc7/tune-go/views/components"
	"github.com/lemonc7/tune-go/views/layout"
	"net/url"
	"strconv"
	"strings"
)

templ SearchPage(
	providers []provider.Info,
	request model.SearchRequest,
	result *model.SearchResult,
	message string,
) {
	@layout.Layout("TuneGo", SearchContent(providers, request, result, message))
}

templ SearchContent(
	providers []provider.Info,
	request model.SearchRequest,
	result *model.SearchResult,
	message string,
) {
	<section class="overflow-hidden rounded-2xl border border-indigo-100 bg-gradient-to-br from-indigo-50/90 via-white to-white p-6 shadow-sm">
		<header class="mb-5">
			<p class="mb-1 text-[0.65rem] font-extrabold uppercase tracking-[0.15em] text-indigo-600">TuneGo Search</p>
			<h1 class="mb-1 text-2xl font-bold">找到想听的音乐</h1>
			<p class="text-sm text-slate-500">选择音乐源，按歌曲、歌手或专辑搜索。</p>
		</header>
		<form
			class="space-y-4"
			action="/"
			method="get"
			hx-get="/"
			hx-target="#search-results"
			hx-swap="innerHTML"
			hx-indicator="#search-loading"
			hx-push-url="true"
		>
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-[minmax(10rem,0.3fr)_minmax(16rem,1fr)]">
				<label class="grid gap-1.5 text-xs font-semibold text-slate-600">
					音乐源
					<select name="provider" required class="rounded-lg border border-indigo-200 px-3 py-2.5 text-sm shadow-sm focus:border-indigo-600 focus:outline-hidden focus:ring-2 focus:ring-indigo-600/20">
						for _,item := range providers {
							<option
								value={ item.Name }
								disabled?={ !item.Available }
								selected?={ request.Provider == item.Name }
							>
								{ item.Name }
							</option>
						}
					</select>
				</label>
				<label class="grid gap-1.5 text-xs font-semibold text-slate-600">
					关键词
					<input
						name="q"
						type="search"
						placeholder="歌曲、歌手或专辑"
						value={ request.Query }
						required
						class="rounded-lg border border-indigo-200 px-3 py-2.5 text-sm shadow-sm focus:border-indigo-600 focus:outline-hidden focus:ring-2 focus:ring-indigo-600/20"
					/>
				</label>
			</div>
			<div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
				<label class="inline-flex cursor-pointer items-center gap-3 rounded-xl border border-indigo-100 bg-white/80 px-3 py-2.5">
					<input name="lossless" type="checkbox" value="true" checked?={ request.Lossless } class="sr-only peer"/>
					<span class="relative h-5 w-9 shrink-0 rounded-full bg-slate-300 transition-colors peer-checked:bg-indigo-600 after:absolute after:top-0.5 after:left-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:after:translate-x-4"></span>
					<span class="grid gap-0.5">
						<strong class="text-sm text-slate-700">仅显示无损</strong>
						<small class="text-xs text-slate-400">FLAC / APE / Hi-Res</small>
					</span>
				</label>
				<div class="flex w-full items-center justify-end gap-3 sm:w-auto">
					<span id="search-loading" class="htmx-indicator hidden text-sm text-indigo-600">搜索中...</span>
					<button type="submit" class="cursor-pointer rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white hover:bg-indigo-700 transition-colors">搜索音乐</button>
				</div>
			</div>
			<input name="page" type="hidden" value="1"/>
			<input name="limit" type="hidden" value="20"/>
		</form>
	</section>
	<section id="search-results" aria-live="polite" class="rounded-2xl border border-slate-200 bg-white/95 p-6 shadow-sm">
		if message != "" {
			@components.ErrorNotice(message)
		} else if result != nil {
			@SearchResults(*result, request.Lossless)
		} else {
			@components.Empty("请输入关键词开始搜索")
		}
	</section>
}

templ SearchResults(result model.SearchResult, lossless bool) {
	if len(result.Tracks) == 0 {
		@components.Empty("本页没有符合条件的歌曲")
	} else {
		<div class="mb-3 flex items-baseline justify-between gap-3">
			<h2 class="text-lg font-bold">搜索结果</h2>
			<span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-600">{ fmt.Sprintf("第 %d 页 · 共 %d 首", result.Page, result.Total) }</span>
		</div>
		for _,track := range result.Tracks {
			<div class="mt-3 flex gap-3 rounded-xl border border-slate-200 bg-white p-4 transition-shadow hover:shadow-sm">
				if track.CoverURL != "" {
					<img src={ track.CoverURL } alt={ track.Name } width="72" height="72" loading="lazy" class="shrink-0 rounded-lg bg-slate-200 object-cover"/>
				}
				<div class="min-w-0 flex-1">
					<h3 class="mb-1 font-semibold">{ track.Name }</h3>
					<p class="mb-2 text-sm text-slate-500">{ strings.Join(track.Artists, " / ") }</p>
					if track.Album != "" {
						<p class="mb-2 text-xs text-slate-400">专辑: { track.Album }</p>
					}
					<div class="flex flex-wrap gap-2">
						for _,quality := range track.Qualities {
							@components.ResolveButton(track, quality)
						}
					</div>
					<div class="download-feedback mt-2" id={ "resolve-" + track.Provider + "-" + track.ID }></div>
				</div>
			</div>
		}
		@SearchPagination(result, lossless)
	}
}

templ SearchPagination(result model.SearchResult, lossless bool) {
	if totalPages(result) > 1 {
		<div class="mt-4 flex items-center justify-center gap-3 border-t border-slate-200 pt-4">
			if result.Page > 1 {
				<a
					href={ searchPageURL(result, lossless, result.Page-1) }
					hx-get={ searchPageURL(result, lossless, result.Page-1) }
					hx-target="#search-results"
					hx-swap="innerHTML"
					hx-push-url="true"
					class="min-w-[5rem] rounded-lg bg-indigo-50 px-3 py-2 text-center text-sm font-bold text-indigo-600 hover:bg-indigo-600 hover:text-white transition-colors"
				>上一页</a>
			} else {
				<span class="min-w-[5rem] rounded-lg bg-slate-100 px-3 py-2 text-center text-sm text-slate-400">上一页</span>
			}
			<span class="text-sm font-bold text-slate-600 tabular-nums">{ fmt.Sprintf("%d / %d", result.Page, totalPages(result)) }</span>
			if result.Page < totalPages(result) {
				<a
					href={ searchPageURL(result, lossless, result.Page+1) }
					hx-get={ searchPageURL(result, lossless, result.Page+1) }
					hx-target="#search-results"
					hx-swap="innerHTML"
					hx-push-url="true"
					class="min-w-[5rem] rounded-lg bg-indigo-50 px-3 py-2 text-center text-sm font-bold text-indigo-600 hover:bg-indigo-600 hover:text-white transition-colors"
				>下一页</a>
			} else {
				<span class="min-w-[5rem] rounded-lg bg-slate-100 px-3 py-2 text-center text-sm text-slate-400">下一页</span>
			}
		</div>
	}
}

func totalPages(result model.SearchResult) int {
	if result.Limit <= 0 || result.Total <= 0 {
		return 0
	}
	return (result.Total + result.Limit - 1) / result.Limit
}

func searchPageURL(result model.SearchResult, lossless bool, page int) string {
	values := url.Values{}
	values.Set("provider", result.Provider)
	values.Set("q", result.Query)
	values.Set("page", strconv.Itoa(page))
	values.Set("limit", strconv.Itoa(result.Limit))
	if lossless {
		values.Set("lossless", "true")
	}
	return "/?" + values.Encode()
}
