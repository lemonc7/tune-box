package pages

import (
	"fmt"
	"github.com/lemonc7/tune-go/internal/model"
	"github.com/lemonc7/tune-go/views/components"
	"github.com/lemonc7/tune-go/views/layout"
)

templ DownloadsPage(items []model.DownloadHistory) {
	@layout.Layout("下载历史", DownloadsContent(items))
}

templ DownloadsContent(items []model.DownloadHistory) {
	<section class="rounded-2xl border border-slate-200 bg-white/95 p-6 shadow-sm">
		<h1 class="mb-4 text-2xl font-bold">下载历史</h1>
		@DownloadList(items, true)
	</section>
}

templ DownloadList(items []model.DownloadHistory, polling bool) {
	<div
		id="download-list"
		if polling {
			hx-get="/web/downloads"
			hx-trigger="every 2s, downloadsChanged from:body"
			hx-swap="outerHTML"
		}
	>
		if len(items) == 0 {
			@components.Empty("暂无下载记录")
		} else {
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-slate-200 text-left text-xs font-semibold uppercase text-slate-400">
							<th class="px-3 py-2.5">歌曲</th>
							<th class="hidden px-3 py-2.5 sm:table-cell">平台</th>
							<th class="hidden px-3 py-2.5 sm:table-cell">音质</th>
							<th class="hidden px-3 py-2.5 md:table-cell">大小</th>
							<th class="px-3 py-2.5">状态</th>
							<th class="px-3 py-2.5 text-right">操作</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						for _, item := range items {
							<tr id={ fmt.Sprintf("download-%d", item.ID) } class="transition-colors hover:bg-slate-50/50">
								<td class="px-3 py-3">
									<div class="min-w-0">
										<span class="block truncate font-semibold text-slate-800">{ item.Name }</span>
										if len(item.Artists) > 0 {
											<span class="block truncate text-xs text-slate-400">{ formatArtists(item.Artists) }</span>
										}
										if item.Status == "downloading" && item.DownloadedBytes > 0 && item.TotalBytes > 0 {
											<div class="mt-1.5 flex items-center gap-2">
												<progress class="h-1.5 flex-1 rounded-full indigo-600-indigo-600 [&::-webkit-progress-bar]:rounded-full [&::-webkit-progress-bar]:bg-slate-100 [&::-webkit-progress-value]:rounded-full" value={ fmt.Sprintf("%d", item.Progress) } max="100"></progress>
												<span class="min-w-[2.8rem] text-right text-xs tabular-nums text-indigo-600">{ fmt.Sprintf("%d%%", item.Progress) }</span>
											</div>
										}
										if item.ErrorMessage != nil {
											<p class="mt-1 truncate text-xs text-red-500">{ *item.ErrorMessage }</p>
										}
									</div>
								</td>
								<td class="hidden px-3 py-3 sm:table-cell">
									<span class="rounded-md bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-600">{ item.Provider }</span>
								</td>
								<td class="hidden px-3 py-3 sm:table-cell">
									<span class="rounded-md bg-green-50 px-2 py-0.5 text-xs font-semibold text-green-700">{ item.Quality }</span>
								</td>
								<td class="hidden whitespace-nowrap px-3 py-3 text-slate-500 md:table-cell">
									if item.TotalBytes > 0 {
										<span>{ formatBytes(item.TotalBytes) }</span>
									} else {
										<span class="text-slate-300">—</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-3">
									<span class={ statusClass(item.Status) + " rounded-md px-2 py-0.5 text-xs font-bold" }>{ statusText(item.Status) }</span>
								</td>
								<td class="whitespace-nowrap px-3 py-3 text-right">
									<div class="flex justify-end gap-1">
										switch item.Status {
											case "pending","resolving","downloading":
												<button
													class="cursor-pointer rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-100"
													hx-post={ fmt.Sprintf("/web/downloads/%d/pause", item.ID) }
													hx-target="#download-list"
													hx-swap="outerHTML"
												>暂停</button>
												<button
													class="cursor-pointer rounded-md border border-red-200 bg-red-50 px-2 py-1 text-xs font-semibold text-red-600 hover:bg-red-100"
													hx-post={ fmt.Sprintf("/web/downloads/%d/cancel", item.ID) }
													hx-target="#download-list"
													hx-swap="outerHTML"
													hx-confirm="确定取消？"
												>取消</button>
											case "paused":
												<button
													class="cursor-pointer rounded-md border border-green-200 bg-green-50 px-2 py-1 text-xs font-semibold text-green-700 hover:bg-green-100"
													hx-post={ fmt.Sprintf("/web/downloads/%d/resume", item.ID) }
													hx-target="#download-list"
													hx-swap="outerHTML"
												>继续</button>
												<button
													class="cursor-pointer rounded-md border border-red-200 bg-red-50 px-2 py-1 text-xs font-semibold text-red-600 hover:bg-red-100"
													hx-post={ fmt.Sprintf("/web/downloads/%d/cancel", item.ID) }
													hx-target="#download-list"
													hx-swap="outerHTML"
													hx-confirm="确定取消？"
												>取消</button>
											case "failed","cancelled":
												<button
													class="cursor-pointer rounded-md border border-indigo-200 bg-indigo-50 px-2 py-1 text-xs font-semibold text-indigo-600 hover:bg-indigo-100"
													hx-post={ fmt.Sprintf("/web/downloads/%d/retry", item.ID) }
													hx-target="#download-list"
													hx-swap="outerHTML"
												>重试</button>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

func statusClass(status string) string {
	switch status {
	case "pending", "resolving", "downloading":
		return "bg-amber-50 text-amber-700"
	case "tagging":
		return "bg-indigo-50 text-indigo-700"
	case "paused":
		return "bg-slate-100 text-slate-500"
	case "completed":
		return "bg-green-50 text-green-700"
	case "failed":
		return "bg-red-50 text-red-700"
	case "cancelled":
		return "bg-slate-100 text-slate-400"
	default:
		return "bg-slate-100 text-slate-500"
	}
}

func statusText(status string) string {
	switch status {
	case "pending":
		return "排队中"
	case "resolving":
		return "解析中"
	case "downloading":
		return "下载中"
	case "tagging":
		return "写标签"
	case "paused":
		return "已暂停"
	case "completed":
		return "已完成"
	case "failed":
		return "失败"
	case "cancelled":
		return "已取消"
	default:
		return status
	}
}

func formatBytes(size int64) string {
	const kb, mb, gb = 1024, 1024 * 1024, 1024 * 1024 * 1024
	switch {
	case size >= gb:
		return fmt.Sprintf("%.1f GB", float64(size)/float64(gb))
	case size >= mb:
		return fmt.Sprintf("%.1f MB", float64(size)/float64(mb))
	case size >= kb:
		return fmt.Sprintf("%.1f KB", float64(size)/float64(kb))
	default:
		return fmt.Sprintf("%d B", size)
	}
}

func formatArtists(artists []string) string {
	switch len(artists) {
	case 0:
		return ""
	case 1:
		return artists[0]
	default:
		result := artists[0]
		for i := 1; i < len(artists); i++ {
			result += " / " + artists[i]
		}
		return result
	}
}
