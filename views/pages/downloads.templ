package pages

import (
	"fmt"
	"github.com/lemonc7/tune-go/internal/model"
	"github.com/lemonc7/tune-go/views/components"
	"github.com/lemonc7/tune-go/views/layout"
)

templ DownloadsPage(items []model.DownloadHistory) {
	@layout.Layout("下载历史", DownloadsContent(items))
}

templ DownloadsContent(items []model.DownloadHistory) {
	<section class="rounded-2xl border border-slate-200 bg-white/95 p-6 shadow-sm">
		<h1 class="mb-4 text-2xl font-bold">下载历史</h1>
		@DownloadList(items, true)
	</section>
}

templ DownloadList(items []model.DownloadHistory, polling bool) {
	<div
		id="download-list"
		if polling {
			hx-get="/web/downloads"
			hx-trigger="every 2s, downloadsChanged from:body"
			hx-swap="outerHTML"
		}
	>
		if len(items) == 0 {
			@components.Empty("暂无下载记录")
		} else {
			<div class="space-y-3">
				for _,item := range items {
					@DownloadItem(item)
				}
			</div>
		}
	</div>
}

templ DownloadItem(item model.DownloadHistory) {
	<div class="grid grid-cols-1 gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-xs transition-shadow hover:shadow-sm sm:grid-cols-[1fr_auto]" id={ fmt.Sprintf("download-%d", item.ID) }>
		<div class="min-w-0 space-y-2.5">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<strong class="truncate text-base font-semibold">{ item.Name }</strong>
				<div class="flex flex-wrap items-center gap-1.5 text-xs">
					<span class="rounded-md bg-accent-light px-2 py-0.5 font-semibold text-accent">{ item.Provider }</span>
					<span class="rounded-md bg-green-50 px-2 py-0.5 font-semibold text-green-700">{ item.Quality }</span>
				</div>
			</div>
			if item.Status == "downloading" || item.Status == "tagging" {
				<div class="flex items-center gap-3">
					<progress class="h-2 flex-1 rounded-full accent-accent [&::-webkit-progress-bar]:rounded-full [&::-webkit-progress-bar]:bg-slate-100 [&::-webkit-progress-value]:rounded-full" value={ fmt.Sprintf("%d", item.Progress) } max="100"></progress>
					<span class="min-w-[2.8rem] text-right text-sm font-bold text-accent">{ fmt.Sprintf("%d%%", item.Progress) }</span>
				</div>
			}
			if item.Status == "downloading" && item.DownloadedBytes > 0 && item.TotalBytes > 0 {
				<span class="text-xs text-slate-400">{ formatBytes(item.DownloadedBytes) + " / " + formatBytes(item.TotalBytes) }</span>
			}
			if item.ErrorMessage != nil {
				<p class="rounded-lg bg-red-50 px-3 py-2 text-xs text-red-600">{ *item.ErrorMessage }</p>
			}
		</div>
		<div class="flex flex-row items-center justify-between gap-2 sm:flex-col sm:items-end sm:justify-center">
			<span class={ statusClass(item.Status) + " rounded-md px-2 py-0.5 text-xs font-bold" }>{ statusText(item.Status) }</span>
			<div class="flex gap-1">
				switch item.Status {
					case "pending","resolving","downloading":
						<button
							class="cursor-pointer rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100"
							hx-post={ fmt.Sprintf("/web/downloads/%d/pause", item.ID) }
							hx-target="#download-list"
							hx-swap="outerHTML"
						>暂停</button>
						<button
							class="cursor-pointer rounded-md border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100"
							hx-post={ fmt.Sprintf("/web/downloads/%d/cancel", item.ID) }
							hx-target="#download-list"
							hx-swap="outerHTML"
							hx-confirm="确定取消？"
						>取消</button>
					case "paused":
						<button
							class="cursor-pointer rounded-md border border-green-200 bg-green-50 px-2.5 py-1.5 text-xs font-semibold text-green-700 hover:bg-green-100"
							hx-post={ fmt.Sprintf("/web/downloads/%d/resume", item.ID) }
							hx-target="#download-list"
							hx-swap="outerHTML"
						>继续</button>
						<button
							class="cursor-pointer rounded-md border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100"
							hx-post={ fmt.Sprintf("/web/downloads/%d/cancel", item.ID) }
							hx-target="#download-list"
							hx-swap="outerHTML"
							hx-confirm="确定取消？"
						>取消</button>
					case "failed","cancelled":
						<button
							class="cursor-pointer rounded-md border border-indigo-200 bg-accent-light px-2.5 py-1.5 text-xs font-semibold text-accent hover:bg-indigo-100"
							hx-post={ fmt.Sprintf("/web/downloads/%d/retry", item.ID) }
							hx-target="#download-list"
							hx-swap="outerHTML"
						>重试</button>
				}
			</div>
		</div>
	</div>
}

func statusClass(status string) string {
	switch status {
	case "pending", "resolving", "downloading":
		return "bg-amber-50 text-amber-700"
	case "tagging":
		return "bg-indigo-50 text-indigo-700"
	case "paused":
		return "bg-slate-100 text-slate-500"
	case "completed":
		return "bg-green-50 text-green-700"
	case "failed":
		return "bg-red-50 text-red-700"
	case "cancelled":
		return "bg-slate-100 text-slate-400"
	default:
		return "bg-slate-100 text-slate-500"
	}
}

func statusText(status string) string {
	switch status {
	case "pending":
		return "排队中"
	case "resolving":
		return "解析中"
	case "downloading":
		return "下载中"
	case "tagging":
		return "写标签"
	case "paused":
		return "已暂停"
	case "completed":
		return "已完成"
	case "failed":
		return "失败"
	case "cancelled":
		return "已取消"
	default:
		return status
	}
}

func formatBytes(size int64) string {
	const kb, mb, gb = 1024, 1024 * 1024, 1024 * 1024 * 1024
	switch {
	case size >= gb:
		return fmt.Sprintf("%.1f GB", float64(size)/float64(gb))
	case size >= mb:
		return fmt.Sprintf("%.1f MB", float64(size)/float64(mb))
	case size >= kb:
		return fmt.Sprintf("%.1f KB", float64(size)/float64(kb))
	default:
		return fmt.Sprintf("%d B", size)
	}
}
