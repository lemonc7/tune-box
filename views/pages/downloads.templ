package pages

import (
	"fmt"
	"github.com/lemonc7/tune-go/model"
	"github.com/lemonc7/tune-go/views/components"
	"github.com/lemonc7/tune-go/views/layout"
)

templ DownloadsPage(items []model.DownloadHistory) {
	@layout.Layout("下载历史", DownloadsContent(items))
}

templ DownloadsContent(items []model.DownloadHistory) {
	<section>
		<h1>下载历史</h1>
		@DownloadList(items, true)
	</section>
}

templ DownloadList(items []model.DownloadHistory, polling bool) {
	<div
		id="download-list"
		if polling {
			hx-get="/web/downloads"
			hx-trigger="every 2s, downloadsChanged from:body"
			hx-swap="outerHTML"
		}
	>
		if len(items) == 0 {
			@components.Empty("暂无下载记录")
		} else {
			<div class="download-list">
				for _,item := range items {
					@DownloadItem(item)
				}
			</div>
		}
	</div>
}

templ DownloadItem(item model.DownloadHistory) {
	<div class="download-card" id={ fmt.Sprintf("download-%d", item.ID) }>
		<div class="download-info">
			<div class="download-head">
				<strong>{ item.Name }</strong>
				<div class="download-meta">
					<span class="badge badge-source">{ item.Provider }</span>
					<span class="badge badge-quality">{ item.Quality }</span>
					if item.Size != nil {
						<span class="download-size">{ formatBytes(*item.Size) }</span>
					}
				</div>
			</div>
			if item.Status == "downloading" || item.Status == "tagging" {
				<div class="progress-row">
					<progress class="download-progress" value={ fmt.Sprintf("%d", item.Progress) } max="100"></progress>
					<span class="progress-pct">{ fmt.Sprintf("%d%%", item.Progress) }</span>
				</div>
			}
			if item.Status == "downloading" && item.DownloadedBytes > 0 && item.TotalBytes > 0 {
				<span class="download-size">{ formatBytes(item.DownloadedBytes) + " / " + formatBytes(item.TotalBytes) }</span>
			}
			if item.ErrorMessage != nil {
				<p class="error">{ *item.ErrorMessage }</p>
			}
		</div>
		<div class="download-actions">
			<span class={ "status-badge status-" + item.Status }>{ downloadStatusText(item.Status) }</span>
			<div class="btn-group">
				switch item.Status {
					case "pending","resolving","downloading":
						<button class="btn-sm"
							hx-post={ fmt.Sprintf("/web/downloads/%d/pause", item.ID) }
							hx-target="#download-list" hx-swap="outerHTML"
						>暂停</button>
						<button class="btn-sm btn-danger"
							hx-post={ fmt.Sprintf("/web/downloads/%d/cancel", item.ID) }
							hx-target="#download-list" hx-swap="outerHTML"
							hx-confirm="确定取消？"
						>取消</button>
					case "paused":
						<button class="btn-sm btn-resume"
							hx-post={ fmt.Sprintf("/web/downloads/%d/resume", item.ID) }
							hx-target="#download-list" hx-swap="outerHTML"
						>继续</button>
						<button class="btn-sm btn-danger"
							hx-post={ fmt.Sprintf("/web/downloads/%d/cancel", item.ID) }
							hx-target="#download-list" hx-swap="outerHTML"
							hx-confirm="确定取消？"
						>取消</button>
					case "failed","cancelled":
						<button class="btn-sm btn-retry"
							hx-post={ fmt.Sprintf("/web/downloads/%d/retry", item.ID) }
							hx-target="#download-list" hx-swap="outerHTML"
						>重试</button>
				}
			</div>
		</div>
	</div>
}

func downloadStatusText(status string) string {
	switch status {
	case "pending": return "排队中"
	case "resolving": return "解析中"
	case "downloading": return "下载中"
	case "tagging": return "写标签"
	case "paused": return "已暂停"
	case "completed": return "已完成"
	case "failed": return "失败"
	case "cancelled": return "已取消"
	default: return status
	}
}

func formatBytes(size int64) string {
	const kb, mb, gb = 1024, 1024*1024, 1024*1024*1024
	switch {
	case size >= gb: return fmt.Sprintf("%.1f GB", float64(size)/float64(gb))
	case size >= mb: return fmt.Sprintf("%.1f MB", float64(size)/float64(mb))
	case size >= kb: return fmt.Sprintf("%.1f KB", float64(size)/float64(kb))
	default: return fmt.Sprintf("%d B", size)
	}
}
