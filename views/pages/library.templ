package pages

import (
	"fmt"
	"github.com/lemonc7/tune-go/internal/model"
	"github.com/lemonc7/tune-go/views/components"
	"github.com/lemonc7/tune-go/views/layout"
)

templ LibraryPage(items []model.Song, keyword string, count int) {
	@layout.Layout("本地曲库", LibraryContent(items, keyword, count))
}

templ LibraryContent(items []model.Song, keyword string, count int) {
	<section class="rounded-2xl border border-slate-200 bg-white/95 p-6 shadow-sm">
		<header class="mb-4 flex flex-wrap items-center justify-between gap-3">
			<h1 class="text-2xl font-bold">本地曲库</h1>
			if count > 0 {
				<span class="rounded-full bg-indigo-50 px-3 py-1 text-sm font-bold text-indigo-600">{ fmt.Sprintf("%d 首", count) }</span>
			}
		</header>
		<form
			class="mb-5 flex gap-3"
			hx-get="/web/library"
			hx-target="#library-results"
			hx-swap="innerHTML"
			hx-trigger="input changed delay:300ms from:find input, search"
		>
			<input
				type="search"
				name="q"
				placeholder="搜索歌名或艺人..."
				value={ keyword }
				autocomplete="off"
				class="w-full max-w-sm rounded-lg border border-slate-200 px-3.5 py-2.5 text-sm shadow-xs focus:border-indigo-600 focus:outline-hidden focus:ring-2 focus:ring-indigo-600/20"
			/>
		</form>
		@LibraryResults(items, keyword)
	</section>
}

templ LibraryResults(items []model.Song, keyword string) {
	<div id="library-results">
		if len(items) == 0 {
			if keyword != "" {
				@components.Empty("没有找到匹配的歌曲")
			} else {
				@components.Empty("曲库为空，下载音乐后自动收录")
			}
		} else {
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-slate-200 text-left text-xs font-semibold uppercase text-slate-400">
							<th class="w-20 px-3 py-2.5">格式</th>
							<th class="px-3 py-2.5">歌曲</th>
							<th class="hidden px-3 py-2.5 sm:table-cell">艺人</th>
							<th class="hidden whitespace-nowrap px-3 py-2.5 text-right md:table-cell">大小</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						for _, item := range items {
							<tr class="transition-colors hover:bg-slate-50/50">
								<td class="px-3 py-3">
									<span class={ extClass(item.Extension) + " rounded px-1.5 py-0.5 text-[0.65rem] font-bold uppercase" }>{ item.Extension }</span>
								</td>
								<td class="px-3 py-3">
									<span class="block truncate font-semibold text-slate-800">{ item.Name }</span>
								</td>
								<td class="hidden max-w-[12rem] truncate px-3 py-3 text-slate-500 sm:table-cell">
									if item.Artists != "" {
										<span>{ item.Artists }</span>
									} else {
										<span class="text-slate-300">—</span>
									}
								</td>
								<td class="hidden whitespace-nowrap px-3 py-3 text-right tabular-nums text-slate-500 md:table-cell">
									{ formatSize(item.Size) }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

func extClass(ext string) string {
	switch ext {
	case "flac":
		return "bg-indigo-100 text-indigo-700"
	case "mp3":
		return "bg-emerald-100 text-emerald-700"
	case "wav":
		return "bg-cyan-100 text-cyan-700"
	case "m4a", "aac":
		return "bg-amber-100 text-amber-700"
	case "ape":
		return "bg-violet-100 text-violet-700"
	case "ogg", "opus":
		return "bg-rose-100 text-rose-700"
	default:
		return "bg-slate-100 text-slate-600"
	}
}

func formatSize(size int64) string {
	const kb, mb, gb = 1024, 1024 * 1024, 1024 * 1024 * 1024
	switch {
	case size >= gb:
		return fmt.Sprintf("%.1f GB", float64(size)/float64(gb))
	case size >= mb:
		return fmt.Sprintf("%.1f MB", float64(size)/float64(mb))
	case size >= kb:
		return fmt.Sprintf("%.1f KB", float64(size)/float64(kb))
	default:
		return fmt.Sprintf("%d B", size)
	}
}
