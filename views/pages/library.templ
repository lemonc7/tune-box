package pages

import (
	"fmt"
	"github.com/lemonc7/tune-go/repo"
	"github.com/lemonc7/tune-go/views/components"
	"github.com/lemonc7/tune-go/views/layout"
	"path/filepath"
	"strings"
)

templ LibraryPage(items []repo.SearchSongsRow, keyword string, count int) {
	@layout.Layout("本地曲库", LibraryContent(items, keyword, count))
}

templ LibraryContent(items []repo.SearchSongsRow, keyword string, count int) {
	<section class="rounded-2xl border border-slate-200 bg-white/95 p-6 shadow-sm">
		<header class="mb-4 flex flex-wrap items-center justify-between gap-3">
			<h1 class="text-2xl font-bold">本地曲库</h1>
			if count > 0 {
				<span class="rounded-full bg-accent-light px-3 py-1 text-sm font-bold text-accent">{ fmt.Sprintf("%d 首", count) }</span>
			}
		</header>
		<form class="mb-4 flex gap-3"
			hx-get="/web/library"
			hx-target="#library-results"
			hx-swap="innerHTML"
			hx-trigger="input changed delay:300ms from:find input, search"
		>
			<input
				type="search"
				name="q"
				placeholder="搜索歌名或艺人..."
				value={ keyword }
				autocomplete="off"
				class="w-full max-w-sm rounded-lg border border-slate-200 px-3.5 py-2.5 text-sm shadow-xs focus:border-accent focus:outline-hidden focus:ring-2 focus:ring-accent/20"
			/>
		</form>
		@LibraryResults(items, keyword)
	</section>
}

templ LibraryResults(items []repo.SearchSongsRow, keyword string) {
	<div id="library-results">
		if len(items) == 0 {
			if keyword != "" {
				@components.Empty("没有找到匹配的歌曲")
			} else {
				@components.Empty("曲库为空，下载音乐后自动收录")
			}
		} else {
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
				for _,item := range items {
					<div class="space-y-2 rounded-xl border border-slate-200 bg-white p-4 shadow-xs transition-shadow hover:shadow-sm">
						<span class="block truncate text-sm font-bold text-slate-800" title={ item.Name }>{ item.Name }</span>
						if item.Artists != "" {
							<span class="block text-xs leading-relaxed text-slate-500">{ item.Artists }</span>
						}
						<div class="flex items-center gap-2 text-xs text-slate-400">
							<span class="rounded bg-accent-light px-1.5 py-0.5 text-[0.65rem] font-bold uppercase text-accent">{ strings.TrimPrefix(strings.ToLower(filepath.Ext(item.Path)), ".") }</span>
						</div>
					</div>
				}
			</div>
		}
	</div>
}
