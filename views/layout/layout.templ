package layout

templ Layout(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="zh-CN">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/x-icon" href="/assets/favicon.ico"/>
			<script src="/assets/htmx.min.js"></script>
			<link rel="stylesheet" href="/assets/app.css"/>
		</head>
		<body hx-boost="true" class="min-h-screen bg-slate-50 text-slate-800 antialiased">
			<header class="sticky top-0 z-10 border-b border-slate-200/60 bg-white/80 backdrop-blur-md">
				<nav class="mx-auto flex max-w-5xl gap-1 px-5 py-3">
					<a href="/" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">搜索</a>
					<a href="/downloads" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">下载历史</a>
					<a href="/library" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">本地曲库</a>
				</nav>
			</header>
			<main class="mx-auto max-w-5xl space-y-5 px-4 py-6 pb-16">
				@content
			</main>
		</body>
	</html>
}
