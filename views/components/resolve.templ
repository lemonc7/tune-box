package components

import (
	"fmt"
	"github.com/lemonc7/tune-go/internal/model"
)

templ ResolveButton(track model.Track, quality model.Quality) {
	<form
		class="inline-flex items-center gap-1"
		hx-post="/web/downloads"
		hx-target={ "#resolve-" + track.Provider + "-" + track.ID }
		hx-swap="innerHTML"
		hx-indicator="find .htmx-indicator"
		hx-disabled-elt="find button"
	>
		<input type="hidden" name="provider" value={ track.Provider }/>
		<input type="hidden" name="trackId" value={ track.ID }/>
		<input type="hidden" name="quality" value={ quality.ID }/>
		<input type="hidden" name="name" value={ track.Name }/>
		<input type="hidden" name="album" value={ track.Album }/>
		<input type="hidden" name="albumArtist" value={ track.AlbumArtist }/>
		<input type="hidden" name="date" value={ track.Date }/>
		<input type="hidden" name="durationMs" value={ fmt.Sprintf("%d", track.DurationMS) }/>
		<input type="hidden" name="coverUrl" value={ track.CoverURL }/>
		for _,artist := range track.Artists {
			<input type="hidden" name="artists" value={ artist }/>
		}
		<button
			type="submit"
			title={ "下载 " + quality.Label }
			class="cursor-pointer rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700 transition-colors"
		>
			<span>下载</span>{ " · " + quality.Label }
		</button>
		<span class="htmx-indicator inline-flex items-center gap-1 text-xs text-indigo-600">
			<svg class="animate-spin h-3 w-3" viewBox="0 0 24 24" fill="none">
				<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
				<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
			</svg>
		</span>
	</form>
}

templ ResolveResource(request model.DownloadRequest, resource model.Resource) {
	<div class="rounded-xl bg-indigo-50/70 p-4 space-y-3">
		<p class="text-sm">
			已解析: <strong>{ resource.Quality.Label }</strong>
			if resource.Quality.Format != "" {
				<span>{ " / " + resource.Quality.Format }</span>
			}
		</p>
		if resource.ExpiresAt != "" {
			<p class="text-xs text-slate-500">资源有效期: { resource.ExpiresAt }</p>
		}
		<form
			hx-post="/web/downloads"
			hx-target="closest .resolved-resource"
			hx-swap="outerHTML"
			hx-disabled-elt="find button"
		>
			<input type="hidden" name="provider" value={ request.Provider }/>
			<input type="hidden" name="trackId" value={ request.TrackID }/>
			<input type="hidden" name="quality" value={ request.Quality }/>
			<input type="hidden" name="name" value={ request.Metadata.Name }/>
			<input type="hidden" name="album" value={ request.Metadata.Album }/>
			<input type="hidden" name="albumArtist" value={ request.Metadata.AlbumArtist }/>
			<input type="hidden" name="date" value={ request.Metadata.Date }/>
			<input type="hidden" name="coverUrl" value={ request.Metadata.CoverURL }/>
			for _,artist := range request.Metadata.Artists {
				<input type="hidden" name="artists" value={ artist }/>
			}
			<button type="submit" class="cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-bold text-white hover:bg-indigo-700 transition-colors">加入下载</button>
		</form>
	</div>
}
